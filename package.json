{
  "name": "@doniq/web",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/api/index.ts",
    "./tokens": "./src/shared/tokens.ts",
    "./landing-app": "./src/shared/landing-app.ts",
    "./politica": "./src/shared/politica.ts",
    "./guia": "./src/shared/guia.ts",
    "./logout": "./src/shared/logout.ts",
    "./estado-voz": "./src/shared/estado-voz.ts"
  },
  "scripts": {
    "build": "tsc -b && NODE_ENV=production vite build && bun run build:api && bun run bundle:check",
    "build:api": "bun build src/api/index.ts --target=node --format=esm --packages=external --outfile=dist-server/app.mjs",
    "dev": "vite",
    "tokens": "bun scripts/gerar-tokens-css.ts",
    "start": "bun src/__server.ts",
    "bundle:analyze": "NODE_ENV=production vite-bundle-visualizer --output bundle-report.html --open true",
    "bundle:check": "bun scripts/check-bundle-size.ts",
    "typecheck": "tsc -b",
    "lint": "cd ../.. && oxlint packages/web --deny-warnings --no-error-on-unmatched-pattern",
    "preview": "bun run build && vite preview",
    "test": "bun --env-file=../../.env test",
    "test:smoke": "node ../../smoke-test-app.js",
    "test:all": "bun run test && bun run test:smoke",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:preflight": "bun --env-file=../../.env scripts/preflight-migrations.ts",
    "db:migrate": "bun run db:preflight && bun --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env drizzle-kit push"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.19",
    "@gsap/react": "^2.1.2",
    "@libsql/client": "^0.17.2",
    "@orpc/client": "^1.14.7",
    "@orpc/server": "^1.14.7",
    "@orpc/tanstack-query": "^1.14.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/browser": "^10.72.0",
    "@tanstack/react-query": "^5.100.6",
    "ai": "^6",
    "autumn-js": "1.2.28",
    "better-auth": "1.6.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dedent": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "hono": "^4.12.10",
    "lucide-react": "^0.577.0",
    "motion": "^13.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.2",
    "tailwind-merge": "^3.5.0",
    "wouter": "3.5.0",
    "zod": "^4",
    "@vercel/speed-insights": "^1.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.3.5",
    "@types/react": "18.0.38",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.1.4",
    "cssstudio": "1.2.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vercel": "^59.23.2",
    "vite": "^7.3.1",
    "vite-bundle-visualizer": "^1.2.1"
  },
  "description": "DONIQ Web - Vite + React + Hono API"
}